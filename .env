# Backend port shared across all four backend implementations.
# Exactly one backend must bind this port at a time.
# Each backend reads its own env var (below) — all default to 42621 so the
# Angular frontend's proxy.conf.json works unchanged regardless of choice.

NESTJS_BACKEND_PORT=42411
SPRING_BACKEND_PORT=42411
FASTAPI_BACKEND_PORT=42411
DOTNET_BACKEND_PORT=42411
GIN_BACKEND_PORT=42411
