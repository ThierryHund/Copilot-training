    "serve:backend-gin": "cd apps/backend-gin && go run ./cmd/server",
    "build": "nx run-many -t build --all",
    "lint": "nx run-many -t lint --all",
    "test": "nx run-many -t test --all",
    "openapi:export": "ts-node --project apps/backend-nestjs/tsconfig.app.json apps/backend-nestjs/src/openapi-export.ts"
  },
