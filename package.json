    "serve:backend-nestjs": "nx serve backend-nestjs",
    "serve:backend-spring": "cd apps/backend-spring && ./mvnw spring-boot:run",
    "serve:backend-fastapi": "cd apps/backend-fastapi && uv run uvicorn app.main:app --host 0.0.0.0 --port 42411 --reload",
